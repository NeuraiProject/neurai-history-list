{
  // Type-checks the published declarations the way applications consume
  // them: ESM (dist/types.d.mts) and CommonJS (dist/types.d.ts, CommonJS
  // because the package has no "type": "module"), with skipLibCheck: false
  // (tsc's default) so errors inside the declarations are reported. NodeNext
  // here; see the -node16 and -bundler variants.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": []
  },
  "files": ["types-test/consumer.mts", "types-test/consumer.cts"]
}
