{
  "name": "@neuraiproject/neurai-history-list",
  "version": "1.2.8",
  "description": "A human understandable list of in or outgoing transactions",
  "source": "index.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "dist/types.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "parcel build && node scripts/write-esm-declarations.mjs",
    "watch": "parcel watch",
    "test": "jest test.js && npm run test:types",
    "test:types": "tsc -p tsconfig.types-nodenext.json && tsc -p tsconfig.types-node16.json && tsc -p tsconfig.types-bundler.json",
    "test:package": "node scripts/check-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuraiproject/neurai-history-list.git"
  },
  "keywords": [
    "Neurai"
  ],
  "author": "Neuraiproject",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/neuraiproject/neurai-history-list/issues"
  },
  "devDependencies": {
    "@parcel/packager-ts": "^2.16.4",
    "@parcel/transformer-typescript-types": "^2.16.4",
    "jest": "29.4.1",
    "parcel": "^2.16.4",
    "typescript": "^5.9.3"
  },
  "homepage": "https://github.com/neuraiproject/neurai-history-list#readme"
}
